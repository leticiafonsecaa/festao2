// Banco de dados do Festão
//
// Em desenvolvimento usamos SQLite (nao precisa instalar nada).
// Para publicar em producao, troque provider para "postgresql" e
// aponte DATABASE_URL para o Postgres. Nenhum outro campo muda.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Usuarios
// ---------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  createdAt    DateTime @default(now())

  events        Event[]
  vendor        Vendor?
  quoteRequests QuoteRequest[]
  reviews       Review[]
}

// ---------------------------------------------------------------
// Eventos
// ---------------------------------------------------------------

// type: casamento | aniversario | 15anos | formatura | cha-de-bebe |
//       cha-de-panela | corporativo | batizado | outro
model Event {
  id          String   @id @default(cuid())
  publicCode  String   @unique // codigo do link publico: /convite/abc123
  ownerId     String
  name        String
  type        String
  date        DateTime
  time        String   @default("19:00")
  venue       String   @default("")
  address     String   @default("")
  city        String   @default("")
  description String   @default("")
  hosts       String   @default("")
  coverImage  String   @default("")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  personalization Personalization?
  guests          Guest[]
  gifts           Gift[]
  budgetItems     BudgetItem[]
  quoteRequests   QuoteRequest[]

  @@index([ownerId])
}

model Personalization {
  id             String  @id @default(cuid())
  eventId        String  @unique
  primaryColor   String  @default("#D4A89C")
  secondaryColor String  @default("#C47D6B")
  heroImage      String  @default("")
  tagline        String  @default("Celebre conosco este momento especial")
  showGuestCount Boolean @default(true)
  showGiftList   Boolean @default(true)
  showRsvp       Boolean @default(true)
  showCountdown  Boolean @default(true)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------
// Convidados
// ---------------------------------------------------------------

// rsvp: pending | confirmed | declined
model Guest {
  id           String    @id @default(cuid())
  eventId      String
  inviteToken  String    @unique // link individual do convidado
  name         String
  email        String?
  phone        String?
  rsvp         String    @default("pending")
  plusOne      Boolean   @default(false)
  plusOneName  String?
  companions   Int       @default(0) // acompanhantes alem do plusOne (criancas etc)
  tableName    String?
  dietaryNotes String?
  notes        String?
  checkedIn    Boolean   @default(false)
  checkedInAt  DateTime?
  respondedAt  DateTime?
  createdAt    DateTime  @default(now())

  event         Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservedGifts Gift[]

  @@index([eventId])
}

// ---------------------------------------------------------------
// Lista de presentes
// ---------------------------------------------------------------

model Gift {
  id               String   @id @default(cuid())
  eventId          String
  name             String
  category         String   @default("Geral")
  image            String   @default("")
  description      String   @default("")
  received         Boolean  @default(false)
  receivedBy       String?
  reservedByGuestId String?
  reservedByName   String?
  reservedAt       DateTime?
  createdAt        DateTime @default(now())

  event           Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservedByGuest Guest?      @relation(fields: [reservedByGuestId], references: [id], onDelete: SetNull)
  options         GiftOption[]

  @@index([eventId])
}

model GiftOption {
  id     String @id @default(cuid())
  giftId String
  store  String
  price  Float
  url    String @default("")

  gift Gift @relation(fields: [giftId], references: [id], onDelete: Cascade)

  @@index([giftId])
}

// ---------------------------------------------------------------
// Orcamento do evento
// ---------------------------------------------------------------

// status: previsto | contratado | pago
model BudgetItem {
  id            String   @id @default(cuid())
  eventId       String
  title         String
  category      String   @default("outros")
  estimatedCost Float    @default(0)
  actualCost    Float    @default(0)
  status        String   @default("previsto")
  vendorId      String?
  notes         String   @default("")
  createdAt     DateTime @default(now())

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([eventId])
}

// ---------------------------------------------------------------
// Marketplace de fornecedores
// ---------------------------------------------------------------

// category: fotografia | filmagem | decoracao | buffet | doces | bolo |
//           musica | maquiagem | espacos | convites | lembrancinhas | outros
model Vendor {
  id           String   @id @default(cuid())
  userId       String   @unique
  businessName String
  slug         String   @unique
  category     String
  description  String   @default("")
  city         String
  state         String  @default("")
  servesCities String   @default("") // cidades separadas por virgula
  priceFrom    Float?
  priceUnit    String   @default("evento") // evento | pessoa | hora | diaria
  phone        String   @default("")
  whatsapp     String   @default("")
  instagram    String   @default("")
  website      String   @default("")
  coverImage   String   @default("")
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  ratingAvg    Float    @default(0)
  reviewCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos        VendorPhoto[]
  quoteRequests QuoteRequest[]
  reviews       Review[]
  budgetItems   BudgetItem[]

  @@index([category])
  @@index([city])
}

model VendorPhoto {
  id       String @id @default(cuid())
  vendorId String
  url      String
  caption  String @default("")
  position Int    @default(0)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

// status: pendente | respondido | aceito | recusado
model QuoteRequest {
  id          String    @id @default(cuid())
  vendorId    String
  requesterId String?
  eventId     String?
  name        String
  email       String
  phone       String    @default("")
  eventType   String    @default("")
  eventDate   DateTime?
  guestCount  Int?
  city        String    @default("")
  message     String    @default("")
  status      String    @default("pendente")
  vendorReply String    @default("")
  quotedPrice Float?
  createdAt   DateTime  @default(now())
  repliedAt   DateTime?

  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  requester User?  @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  event     Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([vendorId])
}

model Review {
  id        String   @id @default(cuid())
  vendorId  String
  authorId  String
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, authorId])
  @@index([vendorId])
}
